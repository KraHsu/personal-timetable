[Unit]
Description=Personal timetable
After=network.target

[Service]
Type=simple
User=charles
Group=charles
WorkingDirectory=/home/charles/apps/timetable/current
Environment=TIMETABLE_DATA=/home/charles/apps/timetable/data
Environment=TIMETABLE_ORIGIN=https://timetable.krahsu.top
ExecStart=/usr/local/libexec/timetable-launch --port 8765
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/charles/apps/timetable/data
MemoryMax=160M
TasksMax=64

[Install]
WantedBy=multi-user.target
